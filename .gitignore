# Build output
/bin/
/dist/
*.exe

# Optional local checkouts of upstream projects, for reading while you work.
# Nothing is cloned here by default; see "Prior art" in AGENTS.md.
/reference/

# Local runtime state
/config.yaml
/config.local.yaml
/config.json
/config.local.json
/.env
/workspace/

# Local-only working material: the staged plans and the conformance harness
# are kept out of the repository.
/.devin/plans/
/test/

# Container deployment: the compose file holds machine-local paths and
# mounts; the image is built from the committed Dockerfile.
/docker-compose.yml
/docker-compose.*.yml

# Editor / OS
.vscode-dev/
.idea/
.DS_Store

# Coverage
*.out
coverage.html
